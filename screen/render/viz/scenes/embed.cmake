# cmake -DOUT=<file.cpp> -DSCENES=<a.frag|b.frag> -P embed.cmake: the feedback scenes compiled into the binary (a
# screen has no asset dir to read them from), as embedded_scenes()'s table
set(body "// generated by scenes/embed.cmake from scenes/*.frag; do not edit\n#include \"host/scene_source.h\"\n\n")
string(APPEND body "namespace cadence::render::viz {\n\nconst std::vector<EmbeddedScene>& embedded_scene_sources() {\n")
string(APPEND body "  static const std::vector<EmbeddedScene> scenes = {\n")
string(REPLACE "|" ";" SCENES "${SCENES}")
list(SORT SCENES)
foreach(f ${SCENES})
  get_filename_component(name ${f} NAME_WE)
  file(READ ${f} glsl)
  string(APPEND body "      {\"${name}\", R\"CADENCESCENE(${glsl})CADENCESCENE\"},\n")
endforeach()
string(APPEND body "  };\n  return scenes;\n}\n\n}  // namespace cadence::render::viz\n")
file(WRITE ${OUT}.tmp "${body}")
file(COPY_FILE ${OUT}.tmp ${OUT} ONLY_IF_DIFFERENT)

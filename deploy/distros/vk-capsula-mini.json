{
  "$schema": "./schema.json",
  "name": "vk-capsula-mini",
  "board": "vk-capsula-mini",
  "kind": "speaker",
  "status": "shipping",
  "os": "linux",
  "arch": ["arm64"],
  "package": {
    "format": "tarball",
    "output": "build/device/cadence-{version}-vk-capsula-mini-arm64.tar"
  },
  "builder": {
    "dockerfile": "deploy/builder/device.Dockerfile",
    "image": "debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc",
    "platform": "linux/arm64",
    "command": "make device-build BOARD=vk-capsula-mini"
  },
  "runtime": {
    "libc": "glibc",
    "glibcMax": "2.28",
    "openssl": "3.0",
    "loader": "/lib/ld-linux-aarch64.so.1"

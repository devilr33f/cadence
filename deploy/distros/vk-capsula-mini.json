      "snapshot": "20261104T212339Z",
      "note": "arm64 packages: opus and speexdsp static, libasound as an unversioned stub of bookworm's"
    },
    {
      "name": "zig",
      "source": "prebuilt",
      "use": "build",
      "version": "0.15.2",
      "license": "MIT",
      "url": "https://ziglang.org/download/0.15.2/",
      "sha256ByHost": {

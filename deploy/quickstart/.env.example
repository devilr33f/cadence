# copy to .env, set CADENCE_HOST, then run ./setup.sh

# the address speakers and your browser use: a LAN IP (192.168.1.10), a local name (cadence.lan) or a public domain
CADENCE_HOST=192.168.1.10

# the https port; anything but 443 goes into the address (https://192.168.1.10:8443)
CADENCE_HTTPS_PORT=443
# plain http, only for the redirect and let's encrypt's check
CADENCE_HTTP_PORT=80

# internal: caddy's own CA (works anywhere; browsers and speakers need data/ca.crt)
# your email: a let's encrypt certificate (a public domain whose ports 80 and 443 reach this host)
CADENCE_TLS=internal

# setup.sh adds the lines below this one; keep them: POSTGRES_PASSWORD opens the database it made

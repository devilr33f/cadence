# cmake -DNM=<nm> -DREADELF=<readelf> -DLIBRARY=<libpulse.so.0> -DSYMBOLS=<symbols.txt> -P check-exports.cmake
#
# soloist resolves the shim's functions by name: a missing one is a crash at its first play, an extra one is surface
# nobody reviewed. so the defined dynamic symbols must be exactly symbols.txt, the soname libpulse.so.0, and the
# libraries it needs only libc, libm and libpthread (and the loader): it brings its own c++ runtime
foreach(variable NM READELF LIBRARY SYMBOLS)
  if(NOT ${variable})
    message(FATAL_ERROR "check-exports: ${variable} is not set")
  endif()
endforeach()

execute_process(COMMAND "${NM}" -D --defined-only "${LIBRARY}" OUTPUT_VARIABLE listed RESULT_VARIABLE failed)
if(failed)
  message(FATAL_ERROR "check-exports: nm failed on ${LIBRARY}")
endif()
string(REGEX MATCHALL "[^\n]+" lines "${listed}")
set(exported "")
foreach(line IN LISTS lines)
  string(REGEX REPLACE "^.* ([^ ]+)$" "\\1" name "${line}")
  list(APPEND exported "${name}")
endforeach()

file(STRINGS "${SYMBOLS}" wanted REGEX "[^ ]")
set(extra ${exported})
list(REMOVE_ITEM extra ${wanted})
set(missing ${wanted})
list(REMOVE_ITEM missing ${exported})
if(extra OR missing)
  message(FATAL_ERROR "check-exports: exports differ from symbols.txt\n  extra: ${extra}\n  missing: ${missing}")
endif()
list(LENGTH exported count)
list(LENGTH wanted expected)
if(NOT count EQUAL expected)
  message(FATAL_ERROR "check-exports: ${count} exports, ${expected} in symbols.txt")
endif()

execute_process(COMMAND "${READELF}" -d "${LIBRARY}" OUTPUT_VARIABLE dynamic RESULT_VARIABLE failed)
if(failed)
  message(FATAL_ERROR "check-exports: readelf failed on ${LIBRARY}")
endif()
string(REGEX MATCH "\\(SONAME\\)[^[]*\\[([^]]*)\\]" soname "${dynamic}")
if(NOT CMAKE_MATCH_1 STREQUAL "libpulse.so.0")
  message(FATAL_ERROR "check-exports: soname is '${CMAKE_MATCH_1}', not libpulse.so.0")
endif()
string(REGEX MATCHALL "\\(NEEDED\\)[^[]*\\[[^]]*\\]" needed "${dynamic}")
foreach(entry IN LISTS needed)
  string(REGEX REPLACE "^.*\\[([^]]*)\\]$" "\\1" library "${entry}")
  if(NOT library MATCHES "^(libc\\.so\\.6|libm\\.so\\.6|libpthread\\.so\\.0|ld-linux-[a-z0-9_-]+\\.so\\.[0-9]+)$")
    message(FATAL_ERROR "check-exports: needs ${library}, which soloist's runtime does not have")
  endif()
endforeach()
message(STATUS "check-exports: ${count} exports as symbols.txt, needs only the c library")

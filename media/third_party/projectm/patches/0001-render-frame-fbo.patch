From bed416f09c4f946bbca3815e373686baab79d60e Mon Sep 17 00:00:00 2001
From: s5 <s5@local>
Date: Sat, 14 Nov 2026 09:15:44 +0300
Subject: [PATCH] backport projectm_opengl_render_frame_fbo

---
 src/api/include/projectM-4/render_opengl.h | 5 +++++
 src/libprojectM/ProjectM.cpp               | 6 +++---
 src/libprojectM/ProjectM.hpp               | 2 +-
 src/libprojectM/ProjectMCWrapper.cpp       | 6 ++++++
 4 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/src/api/include/projectM-4/render_opengl.h b/src/api/include/projectM-4/render_opengl.h
index 0a061f7..666faea 100644
--- a/src/api/include/projectM-4/render_opengl.h
+++ b/src/api/include/projectM-4/render_opengl.h
@@ -41,6 +41,11 @@ extern "C" {
  */
 PROJECTM_EXPORT void projectm_opengl_render_frame(projectm_handle instance);
 
+/**
+ * @brief Renders a single frame into the given framebuffer object (0: the default framebuffer).
+ */
+PROJECTM_EXPORT void projectm_opengl_render_frame_fbo(projectm_handle instance, uint32_t framebuffer_object_id);
+
 #ifdef __cplusplus
 } // extern "C"
 #endif
diff --git a/src/libprojectM/ProjectM.cpp b/src/libprojectM/ProjectM.cpp
index 88fa014..4a47d82 100644
--- a/src/libprojectM/ProjectM.cpp
+++ b/src/libprojectM/ProjectM.cpp
@@ -90,7 +90,7 @@ void ProjectM::ResetTextures()
     m_textureManager = std::make_unique<Renderer::TextureManager>(m_textureSearchPaths);
 }
 
-void ProjectM::RenderFrame()
+void ProjectM::RenderFrame(uint32_t targetFramebufferObject)
 {
     // Don't render if window area is zero.
     if (m_windowWidth == 0 || m_windowHeight == 0)
@@ -167,14 +167,14 @@ void ProjectM::RenderFrame()
     m_activePreset->RenderFrame(audioData, renderContext);
 
     // ToDo: Allow external apps to provide a custom target framebuffer.
-    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, targetFramebufferObject);
     glViewport(0, 0, renderContext.viewportSizeX, renderContext.viewportSizeY);
 
 #ifdef USE_GLES
     // On WebGL2 / Chrome ANGLE, the default framebuffer's draw buffer must
     // be explicitly set to GL_BACK after preset rendering, which may leave
     // per-FBO draw buffer state that leaks into FBO 0 on some drivers.
-    GLenum backBuf = GL_BACK;
+    GLenum backBuf = targetFramebufferObject ? GL_COLOR_ATTACHMENT0 : GL_BACK;
     glDrawBuffers(1, &backBuf);
 #endif
 
diff --git a/src/libprojectM/ProjectM.hpp b/src/libprojectM/ProjectM.hpp
index b84e293..8445971 100644
--- a/src/libprojectM/ProjectM.hpp
+++ b/src/libprojectM/ProjectM.hpp
@@ -101,7 +101,7 @@ public:
 
     void ResetTextures();
 
-    void RenderFrame();
+    void RenderFrame(uint32_t targetFramebufferObject = 0);
 
     void SetBeatSensitivity(float sensitivity);
 
diff --git a/src/libprojectM/ProjectMCWrapper.cpp b/src/libprojectM/ProjectMCWrapper.cpp
index d58f123..d60c821 100644
--- a/src/libprojectM/ProjectMCWrapper.cpp
+++ b/src/libprojectM/ProjectMCWrapper.cpp
@@ -171,6 +171,12 @@ void projectm_opengl_render_frame(projectm_handle instance)
     projectMInstance->RenderFrame();
 }
 
+void projectm_opengl_render_frame_fbo(projectm_handle instance, uint32_t framebuffer_object_id)
+{
+    auto projectMInstance = handle_to_instance(instance);
+    projectMInstance->RenderFrame(framebuffer_object_id);
+}
+
 void projectm_set_beat_sensitivity(projectm_handle instance, float sensitivity)
 {
     auto projectMInstance = handle_to_instance(instance);
-- 
2.56.0

